{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"sources": "https://github.com/Zhugey/BetterItemStack",
		"issues": "https://github.com/Zhugey/BetterItemStack/issues"
	},
	"license": "${license}",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.zhugey.betteritemstack.fabric.BetterItemStackFabric"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabric_loader_requires}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
